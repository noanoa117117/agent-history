.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

data/*.db
data/*.db-shm
data/*.db-wal
data/backups/
!data/.gitkeep
data/dead-letter/*
data/logs/*
# Spool files hold raw, not-yet-sanitized hook payloads: never commit them.
data/spool/

.env
.env.*
!.env.example
!.env.vm.example
# Agent CLI state directories: these hold auth.json and session history.
# Keep the Codex hook definition tracked, but ignore every other Codex state
# file (auth.json, sessions, config.toml, and future additions).
.claude/
.codex/**
!.codex/hooks.json
*.key
*.pem
*.p12
*.pfx
*.token
credentials*
secrets*
