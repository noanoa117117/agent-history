.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

data/*.db
data/*.db-shm
data/*.db-wal
!data/.gitkeep
data/dead-letter/*
data/logs/*
# Spool files hold raw, not-yet-sanitized hook payloads: never commit them.
data/spool/

.env
.env.*
!.env.example
# Agent CLI state directories: these hold auth.json and session history.
# Already excluded from the image via .dockerignore; keep them out of Git too.
.claude/
.codex/
!.codex/
!.codex/hooks.json
*.key
*.pem
*.p12
*.pfx
*.token
credentials*
secrets*
