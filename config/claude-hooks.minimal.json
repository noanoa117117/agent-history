{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$AGENT_HISTORY_ROOT/bin/agent-history-claude-hook SessionStart"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$AGENT_HISTORY_ROOT/bin/agent-history-claude-hook SessionEnd"
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$AGENT_HISTORY_ROOT/bin/agent-history-claude-hook UserPromptSubmit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$AGENT_HISTORY_ROOT/bin/agent-history-claude-hook Stop"
          }
        ]
      }
    ]
  }
}
