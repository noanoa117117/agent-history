# VM-local Compose environment. Copy to /etc/agent-history/agent-history-vm.env
# on the Proxmox guest; do not commit the copied file.
# Numeric values only. Set these to `id -u amida` and `id -g amida` in the VM;
# do not use shell expressions such as $(id -u amida) here.
DEV_UID=1000
DEV_GID=1000

# Bind-mount sources inside the VM. Keep these paths on persistent VM storage.
AGENT_HISTORY_VM_WORKSPACE=/srv/agent-history/workspace/agent-history
AGENT_HISTORY_VM_PROJECTS=/srv/agent-history/workspace/projects
AGENT_HISTORY_VM_DATA=/srv/agent-history/data
AGENT_HISTORY_VM_CLAUDE_HOME=/srv/agent-history/claude-home
AGENT_HISTORY_VM_CODEX_HOME=/srv/agent-history/codex-home
AGENT_HISTORY_VM_GITHUB_AUTH=/srv/agent-history/github-auth
AGENT_HISTORY_VM_PROJECT_STATE=/srv/agent-history/project-state
AGENT_HISTORY_PROJECTS_DIR=/workspace/projects

AGENT_HISTORY_REPO_URL=https://github.com/noanoa117117/agent-history.git
AGENT_HISTORY_BRANCH=main
CLAUDE_CODE_VERSION=2.1.220
NODE_VERSION=24.18.1
CODEX_VERSION=0.146.0
