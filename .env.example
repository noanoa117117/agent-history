# The wrapper defaults DEV_UID/DEV_GID to the current host user.
DEV_UID=1000
DEV_GID=1000

# GitHub is the source of truth. Set this to the branch used by the existing workflow.
AGENT_HISTORY_REPO_URL=https://github.com/noanoa117117/agent-history.git
AGENT_HISTORY_BRANCH=main

# Keep the installed Claude Code version reproducible. Change deliberately when upgrading.
CLAUDE_CODE_VERSION=2.1.220

# Node.js and Codex CLI are installed at image build time and pinned here.
# Change deliberately, then run make dev-build.
NODE_VERSION=24.18.1
CODEX_VERSION=0.146.0

LOG_TAIL=200
