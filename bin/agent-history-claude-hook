#!/bin/sh
# Claude Code command hook: spool one event and exit.
#
# Runs on Claude Code's critical path, so this wrapper is deliberately minimal:
#   * /bin/sh, not bash (lower startup cost)
#   * python3 -S skips site initialisation (~6.6ms saved)
#   * the script path is passed directly instead of -m (runpy is not free)
#   * -E is NOT used: it would discard PYTHONPATH
#
# Never returns non-zero: exit code 2 is Claude Code's blocking signal.
set -u

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

exec python3 -S "${REPO_ROOT}/src/agent_history/capture/hook_fast.py" "$@"
