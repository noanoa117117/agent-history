#!/usr/bin/env bash
# Create, but never replace, one agent-history KVM guest on a Proxmox node.
# Run this on the Proxmox host only after its read-only capacity survey has
# selected the VMID, storage, bridge, memory, IP policy, and cloud image.
set -Eeuo pipefail

usage() {
    cat >&2 <<'EOF'
usage: proxmox-agent-history-vm-create \
  --vmid ID --storage STORAGE --bridge BRIDGE --image PATH --image-sha256 SHA256 \
  --ssh-public-key PATH --snippet-storage STORAGE --snippet-path PATH \
  --memory-mib MIB [--cores 4] [--system-disk-gib 32] [--data-disk-gib 64] \
  [--ip-config ip=dhcp] [--hostname agent-history-vm] [--user amida] \
  [--repo-url https://github.com/noanoa117117/agent-history.git]

The script refuses an occupied VMID or hostname and never deletes a VM or disk
after a partial failure.  The SSH public key is copied to cloud-init; private
keys and existing host worktrees are never copied or mounted.
EOF
    exit 64
}

vmid= storage= bridge= image= image_sha256= ssh_public_key= snippet_storage= snippet_path=
memory_mib= cores=4 system_disk_gib=32 data_disk_gib=64 ip_config='ip=dhcp'
hostname=agent-history-vm vm_user=amida repo_url='https://github.com/noanoa117117/agent-history.git'
while [ "$#" -gt 0 ]; do
    case "$1" in
        --vmid|--storage|--bridge|--image|--image-sha256|--ssh-public-key|--snippet-storage|--snippet-path|--memory-mib|--cores|--system-disk-gib|--data-disk-gib|--ip-config|--hostname|--user|--repo-url)
            [ "$#" -ge 2 ] || usage
            key="${1#--}"; printf -v "${key//-/_}" '%s' "$2"; shift 2 ;;
        *) usage ;;
    esac
done

for value in vmid storage bridge image image_sha256 ssh_public_key snippet_storage snippet_path memory_mib; do
    [ -n "${!value}" ] || usage
done
[[ "$vmid" =~ ^[1-9][0-9]{2,5}$ ]] || { echo "VMID must be 3-6 digits" >&2; exit 2; }
[[ "$memory_mib" =~ ^[1-9][0-9]*$ && "$cores" =~ ^[1-9][0-9]*$ ]] || { echo "memory and cores must be positive integers" >&2; exit 2; }
[[ "$system_disk_gib" =~ ^[0-9]+$ && "$data_disk_gib" =~ ^[0-9]+$ ]] \
    && (( system_disk_gib >= 32 && data_disk_gib >= 64 )) \
    || { echo "system disk >=32GiB and data disk >=64GiB are required" >&2; exit 2; }
for command in qm pvesm sha256sum ssh-keygen ip sed; do
    command -v "$command" >/dev/null || { echo "missing required command: $command" >&2; exit 127; }
done
[ -r "$image" ] || { echo "cloud image is not readable: $image" >&2; exit 1; }
[ -r "$ssh_public_key" ] || { echo "SSH public key is not readable: $ssh_public_key" >&2; exit 1; }
ssh-keygen -lf "$ssh_public_key" >/dev/null
actual_hash="$(sha256sum "$image" | awk '{print $1}')"
[ "$actual_hash" = "$image_sha256" ] || { echo "cloud image checksum mismatch" >&2; exit 1; }
ip link show "$bridge" >/dev/null || { echo "network bridge does not exist: $bridge" >&2; exit 1; }
pvesm status | awk 'NR > 1 {print $1}' | grep -Fx "$storage" >/dev/null || { echo "storage does not exist: $storage" >&2; exit 1; }
pvesm status | awk 'NR > 1 {print $1}' | grep -Fx "$snippet_storage" >/dev/null || { echo "snippet storage does not exist: $snippet_storage" >&2; exit 1; }
if qm status "$vmid" >/dev/null 2>&1; then
    echo "VMID collision: $vmid already exists; no changes made" >&2
    exit 2
fi
if qm list | awk 'NR > 1 {print $2}' | grep -Fx "$hostname" >/dev/null; then
    echo "VM name collision: $hostname already exists; no changes made" >&2
    exit 2
fi

template="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)/proxmox/cloud-init-agent-history.yaml.template"
[ -r "$template" ] || { echo "cloud-init template is missing: $template" >&2; exit 1; }
install -d -m 0700 "$(dirname -- "$snippet_path")"
escape_sed() { printf '%s' "$1" | sed 's/[\\/|&]/\\&/g'; }
sed \
    -e "s/__HOSTNAME__/$(escape_sed "$hostname")/g" \
    -e "s/__VM_USER__/$(escape_sed "$vm_user")/g" \
    -e 's|__VM_ROOT__|/srv/agent-history|g' \
    -e "s|__REPO_URL__|$(escape_sed "$repo_url")|g" \
    "$template" > "$snippet_path"
chmod 0600 "$snippet_path"

record="${snippet_path%.yaml}.provisioning.txt"
cat > "$record" <<EOF
created_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
vmid=$vmid
hostname=$hostname
storage=$storage
bridge=$bridge
cores=$cores
memory_mib=$memory_mib
system_disk_gib=$system_disk_gib
data_disk_gib=$data_disk_gib
ip_config=$ip_config
cloud_image=$image
cloud_image_sha256=$actual_hash
cloud_init_snippet_storage=$snippet_storage
cloud_init_snippet_path=$snippet_path
EOF
chmod 0600 "$record"

qm create "$vmid" --name "$hostname" --ostype l26 --cores "$cores" --memory "$memory_mib" \
    --scsihw virtio-scsi-pci --net0 "virtio,bridge=$bridge" --agent enabled=1 --onboot 1
qm importdisk "$vmid" "$image" "$storage"
qm set "$vmid" --scsi0 "$storage:vm-$vmid-disk-0,discard=on,ssd=1" --boot order=scsi0
qm resize "$vmid" scsi0 "${system_disk_gib}G"
qm set "$vmid" --scsi1 "$storage:${data_disk_gib},discard=on,ssd=1,serial=agent-history-data"
qm set "$vmid" --ide2 "$storage:cloudinit" --ciuser "$vm_user" --sshkeys "$ssh_public_key" \
    --ipconfig0 "$ip_config" --cicustom "user=$snippet_storage:snippets/$(basename -- "$snippet_path")"
qm start "$vmid"
echo "created and started VM $vmid ($hostname); record: $record"
